  m_Script: {fileID: 11500000, guid: 598bdb5fe425ecb498ed9ca6c55d8ba0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  allCards:
  - cardPrefab: {fileID: 6039559520840224145, guid: 62523473002f3d840a2c3a53ecb32357, type: 3}
    cardId: 1
    lore: "Maria Caninana\n--------------------------------------------------\nA
      g\xEAmea de Cobra Norato e tamb\xE9m filha de Boi\xFAna. Diferente de seu irm\xE3o,
      Caninana \xE9 extremamente m\xE1, amargurada e cruel. Uma das coisas que ela
      mais gosta de fazer \xE9 causar destrui\xE7\xE3o e aterrorizar banhistas, viajantes
      e ribeirinhos. Ela chegou a brigar feio com o seu irm\xE3o uma vez, mas acabou
      perdendo a luta, fazendo com que ela parasse de causar o mal que sempre causou
      e permitindo que Norato fosse recompensado a se tornar permanentemente humano.\r"
  - cardPrefab: {fileID: 6039559520840224145, guid: c83441248163aa444b21add14d09fca4, type: 3}
    cardId: 2
    lore: "Acutipupu\n--------------------------------------------------\nA Acutipupu
      \xE9 uma criatura que \xE9 homem e mulher ao mesmo tempo, que reside na Serra
      do Jac\xF3. Quando est\xE1 na forma de homem, procria meninos fortes e valentes,
      j\xE1 quando mulher, d\xE1 a luz a meninas bel\xEDssimas, superando as estrelas.
      Ele/Ela teve uma filha com o ind\xEDgena Uai\xFA, chamada Erem, por\xE9m ela
      teve que fugir por situa\xE7\xF5es complicadas com o pai, indo para uma tribo
      chamada Cancelri. Infelizmente, ele declarou guerra contra essa tribo, devido
      a fuga de seu pr\xF3prio pai.\r"
  - cardPrefab: {fileID: 4399526670002313444, guid: 332037c9b3a1a5846b92b539205a7f0d, type: 3}
    cardId: 3
    lore: "Corpo-seco\n--------------------------------------------------\nEssa figura
      \xE9 mais conhecida nas regi\xF5es Sul e Sudeste do Brasil, e ele \xE9 basicamente
      uma alma penada que foi t\xE3o m\xE1 enquanto era um homem que ele n\xE3o foi
      aceito nem no c\xE9u e nem no inferno, nem a pr\xF3pria terra onde ele foi
      enterrado aceitou ele, Assim, ele vaga por a\xED ca\xE7ando outras almas iguais
      a ele, criando novos corpos-secos."
  - cardPrefab: {fileID: 5896973953446664878, guid: 9c459b19088e47e49ad87e5df1445d43, type: 3}
    cardId: 4
    lore: "Cumadre Ful\xF4zinha\n--------------------------------------------------\nTamb\xE9m
      chamada de Comadre Florzinha ou M\xE3e d\u2019 Mata, ela \xE9 uma menina encantadora
      de olhos reluzentes e cabelos ruivos, al\xE9m de ser uma grande protetora da
      floresta. Ela fica furiosa quando encontra ca\xE7adores e outros que podem
      prejudicar o seu ambiente de alguma forma. Apesar disso, ela tamb\xE9m ajuda
      pessoas que est\xE3o perdidas na mata a encontrar o seu caminho de volta."
  - cardPrefab: {fileID: 8236686863404509063, guid: 0b7c56ed263569249845da62a449ae28, type: 3}
    cardId: 5
    lore: "Hipocampo\n--------------------------------------------------\nEssa lenda
      veio da Gr\xE9cia para o Brasil, e basicamente relata uma criatura que \xE9
      uma esp\xE9cie de mistura de cavalo com peixe extremamente temido pelos ind\xEDgenas.
      O padre Francisco Bernardinho de Sousa relatou essa lenda pela primeira vez
      em 1873 no Brasil, e desde ent\xE3o, ningu\xE9m nunca chegou perto da ilha
      onde essa criatura habita.\r"
  - cardPrefab: {fileID: 8951368411162500226, guid: acde15469f1867d408f39319c4a01df0, type: 3}
    cardId: 6
    lore: "Boitat\xE1\n--------------------------------------------------\nTamb\xE9m
      chamado de cobra-de-fogo, o Boitat\xE1 \xE9 uma serpente coberta de chamas
      e com v\xE1rios olhos. A vers\xE3o mais popular da lenda \xE9 de que essa cobra
      flamejante foi uma cria\xE7\xE3o de deuses ind\xEDgenas, para proteger as florestas
      de ca\xE7adores e lenhadores. Logo, o Boitat\xE1 \xE9 uma criatura poderosa,
      guardi\xE3 das matas e dos rios e protetora dos animais, castigando quem ousar
      atacar as florestas."
  - cardPrefab: {fileID: 7468288144863118096, guid: c56b9a93ceb7b894a844e78ec2a8f86b, type: 3}
    cardId: 7
    lore: "Caipora\n--------------------------------------------------\nUma criatura
      fant\xE1stica e muito respeitada pelas comunidades ind\xEDgenas, que costuma
      ser muito confundida com o Curupira, por ser tamb\xE9m uma guardi\xE3 das florestas.
      Apesar de ser pequena, a Caipora \xE9 uma ind\xEDgena forte, com cabelos vermelhos
      e orelhas pontudas. Ela costuma aparecer montada em um enorme porco do mato,
      e ataca seus inimigos transformando-se em diferentes bichos ou at\xE9 mesmo
      ficando invis\xEDvel, caso eles causem danos \xE0 floresta ou cacem animais
      f\xEAmeas gr\xE1vidas."
  - cardPrefab: {fileID: 5190330650449655862, guid: a3d7131dd38387945b0431bf7878a7ad, type: 3}
    cardId: 8
    lore: "Curupira\n--------------------------------------------------\nUma das
      figuras mais conhecidas do folclore brasileiro, muito semelhante \xE0 Caipora,
      tamb\xE9m sendo um guardi\xE3o das florestas. Ele possui o cabelo vermelho,
      que pode ser flamejante, e os p\xE9s virados ao contr\xE1rio, que ele utiliza
      para deixar um rastro de pegadas que confunde quem ataca as matas. Al\xE9m
      disso, ele tamb\xE9m emite sons e assovios para dar medo, sendo bem mais travesso
      do que a Caipora"
  - cardPrefab: {fileID: 5294202111589840730, guid: 5a840cbd8659a0840ae3b437aec3cda2, type: 3}
    cardId: 9
    lore: "Matinta Pereira\n--------------------------------------------------\nA
      Matinta Pereira, ou Matinta Per\xEA, ou apenas Matinta, \xE9 uma bruxa velha
      que pela noite, se transforma em uma coruja e pia bem alto nos telhados das
      casas para conseguir comida ou bebida dos moradores. De dia, ela volta a sua
      forma humana para cobrar o que ela solicitou, e se n\xE3o for atendido, ela
      adoece os moradores. Quando a Matinta est\xE1 perto de morrer, ela passa nas
      casas e pergunta para as mulheres \u201CVoc\xEA quer?\u201D, se uma delas responder
      que sim, ela ser\xE1 a nova Matinta."
  - cardPrefab: {fileID: 3978727217804905427, guid: b0428561f735fea42a1cbf7977635bac, type: 3}
    cardId: 10
    lore: "On\xE7a-boi\n--------------------------------------------------\n\xC9
      exatamente o que o pr\xF3prio nome diz, uma uni\xE3o entre on\xE7a e boi. Ela
      \xE9 muito popular nos estados do Amazonas e do Acre, mantendo as mesmas caracter\xEDsticas
      de uma on\xE7a comum, mas com patas e chifres de boi. A diferen\xE7a desta
      on\xE7a para as on\xE7as comuns s\xE3o que as on\xE7as-boi costumam andar em
      duplas ou grupos, inclusive tendo tanto machos quanto f\xEAmeas."
  - cardPrefab: {fileID: 2012476010080798414, guid: 3e477cf2bb9e4e94c80de940c2ab84d4, type: 3}
    cardId: 11
    lore: "Zumbi da meia noite\n--------------------------------------------------\nTamb\xE9m
      chamado de \u201Cdiabinho da meia noite\u201D, esse zumbi inicia sendo pequeno,
      mas depois de um tempo se transforma em um homem de 3 metros de altura que
      assusta todos \xE0 sua frente. Uma outra vers\xE3o da lenda diz que ele \xE9
      um zumbi que lembra um fantasma e que possui roupas acabadas. Nessa vers\xE3o,
      ele acaba \u201Cvoltando a vida\u201D para resolver tarefas e situa\xE7\xF5es
      que n\xE3o foram resolvidas."
  - cardPrefab: {fileID: 4271095744239718104, guid: 239ddf50b0537064dbe4935be7fc8058, type: 3}
    cardId: 12
    lore: "Boi\xFAna\n--------------------------------------------------\nA Boi\xFAna
      \xE9 uma cobra marinha que controla as \xE1guas, os peixes e tamb\xE9m outros
      seres da floresta. Ela \xE9 t\xE3o poderosa que \xE9 capaz de atacar pescadores,
      afundar barcos e at\xE9 mesmo ter filhos com mulheres, algo que j\xE1 aconteceu
      e resultou nos g\xEAmeos Cobra Norato e Maria Caninana.\r"
  - cardPrefab: {fileID: 5760127748921220890, guid: 4899215d0a45170448432e6ce70a9b30, type: 3}
    cardId: 13
    lore: "Alamoa (humana)\n--------------------------------------------------\nA
      Alamoa \xE9 uma mulher encantadora de olhos azuis e cabelos loiros que surge
      na Praia da Concei\xE7\xE3o, localizada na ilha de Fernando de Noronha, em
      Pernambuco. Ela encanta os homens que se deparam com ela e os leva at\xE9 uma
      montanha extremamente alta, que \xE9 poss\xEDvel de olhar mesmo estando na
      praia. Ao chegar na montanha, ela se revela e castiga suas v\xEDtimas. "
  - cardPrefab: {fileID: 2278773927805323301, guid: 8c6be0753c05a504bae516c50bb8d3be, type: 3}
    cardId: 14
    lore: "Alamoa (metade esqueleto)\n--------------------------------------------------\nEssa
      \xE9 a verdadeira forma da Alamoa, que ela revela ap\xF3s levar os homens para
      a montanha que possui 321 metros de altura. Ao revelar essa forma, ela castiga
      suas v\xEDtimas eternamente, sem que elas possuam sequer uma chance de escapar."
  - cardPrefab: {fileID: 8914199679637205009, guid: 079a08d203138d846b3fc2f67e06a6db, type: 3}
    cardId: 15
    lore: "Cobra Norato\n--------------------------------------------------\nEsse
      \xE9 um dos filhos da Boi\xFAna, g\xEAmeo de Maria Caninana. O Cobra Norato
      \xE9 bom e generoso, e era visto como o her\xF3i que salvava a vida de humanos
      e seres aqu\xE1ticos. Quando tinha festas pela noite, ele se transformava em
      um homem bonito e bem vestido e ia para os bailes para se divertir, e dan\xE7ava
      muito bem. Um dia, ele conseguiu convencer um soldado a quebrar o encanto que
      o mantinha cobra de dia e humano pela noite, tornando-se permanentemente humano.\r"
  - cardPrefab: {fileID: 6665086743147875614, guid: f6e3b59d7a1a503419eb2f0028a5ef02, type: 3}
    cardId: 16
    lore: "Mula sem cabe\xE7a\n--------------------------------------------------\nImagine
      uma mula \u2013 uma cria de jumento com \xE9gua \u2013 que, no lugar da cabe\xE7a,
      tem uma chama fort\xEDssima. \xC9 a mula sem cabe\xE7a. Essa figura \xE9 uma
      puni\xE7\xE3o caso uma mulher traia o seu marido ou tenha um relacionamento
      com um padre. Nos dois casos, a v\xEDtima vira uma mula que queima as florestas
      \xE0 sua frente, assombrando pessoas ou animais pr\xF3ximos. Para quebrar a
      maldi\xE7\xE3o, ela deve esperar o terceiro canto do galo no dia seguinte ou
      percorrer uma dist\xE2ncia equivalente a 7 cidades inteiras."
  - cardPrefab: {fileID: 7400739965624174732, guid: 9148d21c67344f048bfac1a95bab33c0, type: 3}
    cardId: 17
    lore: "Negrinho do Pastoreio\n--------------------------------------------------\nO
      Negrinho do Pastoreio une origem africana, o sul do Brasil e o cristianismo.
      Infelizmente o menino nasceu escravo, e depois de perder um cavalo que o fazendeiro
      ordenou o garoto a vigiar, ele foi punido de forma extremamente cruel. Mas,
      como um milagre, ele ressurgiu em total bem-estar com o cavalo perdido e a
      virgem Maria, fazendo o fazendeiro pagar pela crueldade. Agora, ele procura
      objetos perdidos, desde que algu\xE9m acenda uma vela perto de um formigueiro
      e pe\xE7a com muita f\xE9."
  - cardPrefab: {fileID: 4251406549406915199, guid: 54ed4517c1cfd8d4595d60bf4251ad72, type: 3}
    cardId: 18
    lore: "Cuca\n--------------------------------------------------\n\xC9 imposs\xEDvel
      pensar em folclore e n\xE3o lembrar da Cuca, por ser uma das mais conhecidas
      principalmente no meio infantil, chegando a aparecer nas hist\xF3rias do S\xEDtio
      do Pica Pau Amarelo, de Monteiro Lobato. Ela \xE9 uma bruxa velha que possui
      um corpo que lembra um jacar\xE9 ou crocodilo, \xE9 uma poderosa criadora de
      magias. Geralmente ela procura por crian\xE7as que n\xE3o querem dormir cedo,
      mesmo ap\xF3s ouvir a famosa can\xE7\xE3o \u201CDorme nen\xEA, que a Cuca vem
      pegar, papai foi pra ro\xE7a, mam\xE3e foi trabalhar\u201D. Quando est\xE1
      no final da vida, ela coloca um ovo e dele se origina uma nova Cuca para perturbar
      as crian\xE7as."
  - cardPrefab: {fileID: 2306536976622235060, guid: 133fedc26d6f89e4b82f6296a8cf7f84, type: 3}
    cardId: 19
    lore: "Barba-ruiva (crian\xE7a)\n--------------------------------------------------\nUm
      homem encantado da lagoa de Parnagu\xE1, no Piau\xED. O barba-ruiva \xE9 capaz
      de se transformar em menino, adulto e idoso ao longo de um \xFAnico dia. Uma
      mulher descobriu do nada que estava gr\xE1vida no momento do parto, e optou
      por ter o filho sozinha na mata. Ap\xF3s o menino nascer, ela colocou-o em
      uma bandeja e jogou no rio. Uma grande enchente surgiu ap\xF3s a Iara ver esse
      abandono e ficar extremamente irritada, e no fim da lagoa, alguns habitantes
      escutaram seu choro. Mais tarde, pela manh\xE3, as lavadeiras viram um menino
      por si s\xF3.\r"
  - cardPrefab: {fileID: 7368068189853531148, guid: 91822e926a135f448b3a9675ff4e8d44, type: 3}
    cardId: 20
    lore: "Barba-ruiva (adulto)\n--------------------------------------------------\nPela
      tarde, as lavadeiras viram um homem adulto que possuia barbas ruivas, e nesse
      momento, ele tenta beij\xE1-las e abra\xE7\xE1-las. No final do dia, pela noite,
      ele vira um idoso com barbas brancas. Embora ele tenha sido abandonado, ele
      foi acolhido pela Iara. Para se livrar desse encanto, ele tenta aproximar-se
      desesperadamente de uma mo\xE7a para que ela o liberte do seu encanto jogando
      \xE1gua benta."
  - cardPrefab: {fileID: 3582847596394065982, guid: af0e932e479ce2944b0eebed915a3565, type: 3}
    cardId: 21
    lore: "Boi-vaquim\n--------------------------------------------------\nEssa mistura
      entre touro e p\xE1ssaro \xE9 conhecida como Boi-Vaquim, uma criatura m\xEDstica
      do Rio Grande do Sul. Os chifres soltam fa\xEDsca, fazendo da criatura algo
      ainda mais tem\xEDvel. Alguns vaqueiros t\xEAm medo, j\xE1 outros s\xE3o fascinados
      e possuem o sonho de la\xE7ar e domar essa fera\u2026 algum dia."
  - cardPrefab: {fileID: 7630482217274782917, guid: e02e2376b93e0ce4cb6487f625ac828a, type: 3}
    cardId: 22
    lore: "Iara\n--------------------------------------------------\nUm dos principais
      nomes do folclore brasileiro, a Iara, \xE9 uma sereia ind\xEDgena encantadora
      com longos cabelos e uma bel\xEDssima voz. O seu nome deriva do idioma tupi-guarani
      \u201Cy-\xEEara\u201D, que significa \u201Csenhora das \xE1guas\u201D. Ela
      usa da sua apar\xEAncia bela e de seu canto impec\xE1vel para encantar os homens
      e traz\xEA-los para o fundo do mar."
  - cardPrefab: {fileID: 1496967661646758881, guid: 095fcd93b183f45459fe852678a041c8, type: 3}
    cardId: 23
    lore: "Lobisomem (Homem)\n--------------------------------------------------\nComo
      o pr\xF3prio nome diz, \xE9 uma fus\xE3o entre lobo e homem. A vers\xE3o brasileira
      da lenda relata que um menino foi amaldi\xE7oado, e a consequ\xEAncia dessa
      maldi\xE7\xE3o \xE9 de que toda ter\xE7a ou sexta em que haver\xE1 uma lua
      cheia, o menino se transforma em lobisomem e ataca qualquer um que aparecer
      no seu caminho, seja pessoa ou animal. Para deter essa criatura, \xE9 preciso
      usar objetos cortantes feitos de metal."
  - cardPrefab: {fileID: 7811736583877886540, guid: 4d8bb0058c5843b4b858a93852135a39, type: 3}
    cardId: 24
    lore: "Lobisomem\n--------------------------------------------------\nComo o
      pr\xF3prio nome diz, \xE9 uma fus\xE3o entre lobo e homem. A vers\xE3o brasileira
      da lenda relata que um menino foi amaldi\xE7oado, e a consequ\xEAncia dessa
      maldi\xE7\xE3o \xE9 de que toda ter\xE7a ou sexta em que haver\xE1 uma lua
      cheia, o menino se transforma em lobisomem e ataca qualquer um que aparecer
      no seu caminho, seja pessoa ou animal. Para deter essa criatura, \xE9 preciso
      usar objetos cortantes feitos de metal."
  - cardPrefab: {fileID: 8629628578502145622, guid: 5f713c5d309d3dc4f9a7e8b6a1055d73, type: 3}
    cardId: 25
    lore: "Boto-Cor-de-Rosa (homem)\n--------------------------------------------------\nQuando
      est\xE1 nessa forma, durante as festas, ele procura por mulheres, e as que
      s\xE3o encantadas por sua beleza, acabam resultando em um romance. Por\xE9m,
      ap\xF3s o romance, o Boto-Cor-de-Rosa acaba n\xE3o retornando mais, deixando
      apenas a mulher gr\xE1vida, e os filhos delas s\xE3o conhecidos como \u201Cfilhos
      do Boto\u201D."
  - cardPrefab: {fileID: 274937839199488465, guid: 625047fdfd391304d825f9887656106b, type: 3}
    cardId: 26
    lore: "Boto-Cor-de-Rosa (boto):\n--------------------------------------------------\nUma
      das lendas mais populares do nosso folclore, o Boto ou Boto-Cor-de-Rosa. Ele
      \xE9 em forma literal um boto que vive nos mares, mas quando \xE9 noite de
      festa, ele sai dos mares e encarna um belo homem, para curtir as festas e realizar
      alguns dos seus afazeres."
  - cardPrefab: {fileID: 2547767186743450988, guid: 02e5e90ee28bfba4e8c439ee72516786, type: 3}
    cardId: 27
    lore: "Rom\xE3ozinho: \n--------------------------------------------------\nO
      Rom\xE3ozinho \xE9 um menino extremamente inquieto, travesso e levado. Ele
      mesmo j\xE1 causou muitas brigas entre seus pais, por isso, acabou sendo enfeiti\xE7ado
      a viver para sempre. Ele cria travessuras extremamente insolentes para suas
      v\xEDtimas, rindo de cada uma delas, pois \xE9 disso que ele gosta: rir da
      sua pr\xF3pria maldade."
  - cardPrefab: {fileID: 1210006391155251150, guid: df47fb1ae7df50f4da80c11e3d9f77cd, type: 3}
    cardId: 28
    lore: "Kianumaka Man\xE3 (humana)\n--------------------------------------------------\nTamb\xE9m
      chamada de Deusa On\xE7a, On\xE7a Cabocla, ou Mulher On\xE7a, a Kianumaka Man\xE3
      carrega a for\xE7a das on\xE7as pintadas e \xE9 considerada uma figura de ben\xE7\xE3o
      para as batalhas das tribos ind\xEDgenas, seja na forma humana ou na forma
      de on\xE7a."
  - cardPrefab: {fileID: 8434498046024098586, guid: 70c277a9cd00c9a45bd8a51ba0bea6a2, type: 3}
    cardId: 29
    lore: "Kianumaka Man\xE3 (on\xE7a)\n--------------------------------------------------\nNessa
      forma, a Kianumaka pode aben\xE7oar as tribos ind\xEDgenas de forma ainda mais
      forte, tornando-se uma amea\xE7a ainda maior."
  - cardPrefab: {fileID: 459194246555729235, guid: 3a62f24a2fbb737449a045e069be37b1, type: 3}
    cardId: 30
    lore: "Saci Perer\xEA\n--------------------------------------------------\nEsse
      tamb\xE9m \xE9 um personagem extremamente popular no Brasil inteiro, um menino
      negro que possui apenas uma perna que usa um gorro vermelho, possuindo o poder
      de criar redemoinhos e sair rodopiando por a\xED. O Saci \xE9 um garoto travesso
      que adora pregar uma pe\xE7a nas pessoas, seja escondendo objetos (que dificilmente
      s\xE3o encontrados novamente), fazendo tran\xE7as em animais, queimando comida,
      entre muitos outros. Ele tamb\xE9m \xE9 conhecido como guardi\xE3o das ervas
      e plantas medicinais."
  - cardPrefab: {fileID: 7705875354167057235, guid: 50087da0d4ba364459cbe30d66602d04, type: 3}
    cardId: 31
    lore: "Esqueleto\n--------------------------------------------------\nUm esqueleto
      comum, composto pelos ossos que formam as articula\xE7\xF5es humanas."
  - cardPrefab: {fileID: 7968344059754086567, guid: 2e7687b2a54ff6945b8fe594457aa0ae, type: 3}
    cardId: 32
    lore: "Cobra\n--------------------------------------------------\nUma cobra comum,
      que \xE9 muito usada como base para muitas figuras do folclore brasileiro,
      como o Boitat\xE1, a Boi\xFAna, o Cobra Norato e a Maria Caninana."
  - cardPrefab: {fileID: 6388500400807274352, guid: 3282726b10fe34a4ea3c39f6014eadb9, type: 3}
    cardId: 33
    lore: "On\xE7a\n--------------------------------------------------\nAnimal selvagem
      presente em diversas florestas n\xE3o s\xF3 no Brasil como tamb\xE9m em diferentes
      locais do mundo. No folclore brasileiro, h\xE1 uma variante, a on\xE7a-boi."
  - cardPrefab: {fileID: 55352704697055660, guid: 96c4776e09bd39d4b8e734a4f10d2577, type: 3}
    cardId: 34
    lore: "Lobo-guar\xE1\n--------------------------------------------------\nO lobo-guar\xE1,
      tamb\xE9m chamado guar\xE1, aguar\xE1, aguara\xE7u, lobo-de-crina, lobo-de-juba
      e lobo-vermelho, \xE9 uma animal t\xEDpico na Am\xE9rica do Sul. As suas marcas
      lembram as de uma raposa-vermelha, mas n\xE3o \xE9 uma raposa nem um lobo."
  - cardPrefab: {fileID: 8355250516015290930, guid: 76dd4e4732e9293459516a423301dd84, type: 3}
    cardId: 35
    lore: "Arara azul\n--------------------------------------------------\nTanto
      a arara azul quanto a arara comum s\xE3o s\xEDmbolos da regi\xE3o norte do
      pa\xEDs, principalmente no estado do Amazonas."
  - cardPrefab: {fileID: 1396695273406554873, guid: 2721aae3a1fa26140bb0058b959962f0, type: 3}
    cardId: 36
    lore: "Sapo\n--------------------------------------------------\nUm dos anf\xEDbios
      mais conhecidos, vive em ambientes \xFAmidos, mas que n\xE3o chega a ser aqu\xE1tico."
  - cardPrefab: {fileID: 2823158019547924401, guid: e87f34d5b8650844a87cf6aa015d1979, type: 3}
    cardId: 37
    lore: "Gavi\xE3o Real\n--------------------------------------------------\nO
      gavi\xE3o-real, tamb\xE9m chamado cutucurim, gavi\xE3o-de-penacho, harpia,
      uira\xE7u, uiracuir, uiruuet\xEA, ura\xE7u, \xE1guia-imperial-brasileira, \xE1guia-imperial
      ou uira\xE7u-verdadeiro, \xE9 uma ave acipitriforme da fam\xEDlia dos acipitr\xEDdeos."
  - cardPrefab: {fileID: 2356720914803552942, guid: 08f4ff4e87c245944a3092aafc24e4c6, type: 3}
    cardId: 45
    lore: "Peixe\n--------------------------------------------------\nUm dos animais
      aqu\xE1ticos mais conhecidos, com m\xFAltiplas varia\xE7\xF5es. Diversos tipos
      de peixe s\xE3o alimentos para seres humanos e outras esp\xE9cies"
  - cardPrefab: {fileID: 1148861612748036672, guid: c6a2c5d94da066e45b6450f91f8ba92d, type: 3}
    cardId: 38
    lore: "Batata da purga: \n--------------------------------------------------\nAlimento
      muito cultivado na agricultura ind\xEDgena, do qual os ind\xEDgenas tamb\xE9m
      aproveitaram muito de suas propriedades medicinais. \xC9 nativa do Brasil,
      existindo naturalmente em todas as regi\xF5es, exceto na regi\xE3o sul. Possui
      folhas grandes e flores vistosas, afuniladas e rajadas."
  - cardPrefab: {fileID: 498975883805302358, guid: aa590286bfec0c94fabd903169a01126, type: 3}
    cardId: 39
    lore: "Guaran\xE1\n--------------------------------------------------\nA famosa
      fruta que resulta em muitos refrigerantes brasileiros tamb\xE9m tem liga\xE7\xE3o
      com o folclore. A lenda conta que um casal de ind\xEDgenas desejava ter filhos,
      ent\xE3o eles pediram ao deus Tup\xE3 para que tivessem a capacidade de procriar.
      E ent\xE3o, nasceu um lindo menino, chamado Cau\xEA, que podia falar com as
      plantas e os animais. A fruta lembra o tom de pele de Cau\xEA e as sementes
      lembram os seus olhos."
  - cardPrefab: {fileID: 7956908016550133557, guid: bd4eb45972d294d4f8c86ebe9bcc0eed, type: 3}
    cardId: 40
    lore: "Inhame\n--------------------------------------------------\nOutro alimento
      que \xE9 extremamente aproveitado, mesmo que n\xE3o tanto quanto o milho ou
      outros alimentos. \xC9 uma especiaria extremamente nutritiva, vers\xE1til e
      rica em carboidratos, fibras, minerais e vitaminas."
  - cardPrefab: {fileID: 6798199668483171033, guid: d0f77bf284867f94984cd406ef6f0047, type: 3}
    cardId: 41
    lore: "Ipecacuanha\n--------------------------------------------------\nUma planta
      bastante comum na agricultura ind\xEDgena, onde tamb\xE9m foram aproveitadas
      as propriedades medicinais. Atualmente, \xE9 muito presente nos estados da
      Bahia e Mato Grosso."
  - cardPrefab: {fileID: 7255801898811531540, guid: 643a2fdf745b7eb45a51aa1c5c2bd0ec, type: 3}
    cardId: 42
    lore: "Jerimum (ab\xF3bora)\n--------------------------------------------------\nNo
      Norte e Nordeste do pa\xEDs, \u201Cjerimum\u201D \xE9 muito utilizado para
      se referir a ab\xF3bora. Essa \xE9 uma fruta extremamente rica em vitaminas,
      fibras e antioxidantes."
  - cardPrefab: {fileID: 5347174286613764882, guid: afa990209bdbe234c872127a2448fbe7, type: 3}
    cardId: 43
    lore: "Milho\n--------------------------------------------------\nAlimento muito
      comum e considerado important\xEDssimo na agricultura das comunidades ind\xEDgenas.
      Um cereal altamente consumido e que possui muitas qualidades nutricionais."
  - cardPrefab: {fileID: 6152942758754939017, guid: 136762fcba9db504187b0cfcedc9cd14, type: 3}
    cardId: 44
    lore: "Vit\xF3ria-r\xE9gia\n--------------------------------------------------\nApesar
      de ser uma planta aqu\xE1tica t\xEDpica da regi\xE3o amaz\xF4nica, ela \xE9
      uma lenda do folclore brasileiro. Uma ind\xEDgena chamada Nai\xE1 era apaixonada
      pela deusa da Lua: Jaci, desejando ir pro c\xE9u para se tornar uma das estrelas
      para ficar pr\xF3xima da deusa. Por\xE9m, Nai\xE1 acabou se acidentando no
      rio, tentando encontrar-se com Jaci, o que fez com que Jaci decidisse transform\xE1-la
      na famosa planta aqu\xE1tica."
  cardDisplayArea: {fileID: 1062840914}
  storyText: {fileID: 1313346708}
  prevButton: {fileID: 507280639}
  nextButton: {fileID: 1641849007}
